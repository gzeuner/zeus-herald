# Telegram Bot API (https://core.telegram.org/bots)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# For multi-recipient delivery, set TELEGRAM_CHAT_ID to a private group chat id.
# Find it with: npm run telegram:chat-id
# Optional: set to false/0 to force-disable even if credentials are present
# TELEGRAM_ENABLED=true

# ntfy topic URL (e.g. https://ntfy.sh/your-topic or self-hosted)
NTFY_URL=
# Optional bearer token for private/self-hosted ntfy
# NTFY_TOKEN=
# NTFY_ENABLED=true


# Mobile transfer / one-shot notify
# npm run notify:latest sends the newest image from NOTIFY_LATEST_DIR.
# NOTIFY_LATEST_DIR=images/received
# NOTIFY_IMAGE_PATH=
# NOTIFY_CAPTION=zeus-herald camera image
# Images are compressed centrally before Telegram/ntfy upload.
# NOTIFIER_IMAGE_COMPRESSION_ENABLED=true
# NOTIFIER_IMAGE_MAX_WIDTH=1280
# NOTIFIER_IMAGE_JPEG_QUALITY=72
# Shared notifier HTTP timeout (ms)
# NOTIFIER_TIMEOUT_MS=30000

# Runtime hardening
# QUEUE_MAX_SIZE=100
# QUEUE_DROP_POLICY=drop_oldest
# HEARTBEAT_MS=60000
# SHUTDOWN_TIMEOUT_MS=15000
# HEALTH_FILE=state/health.json
# DECISION_LOG=0
# DECISION_LOG_FILE=logs/decisions.ndjson

# --- Ingest ---
# CAMERA_TYPE=reolink
# CAMERA_ID=front
# INGEST_MODE=files_only
# INGEST_MODE=direct_notify
# INGEST_TARGET_DIR=images/received
# INGEST_INTERVAL_MS=5000
# INGEST_TIMEOUT_MS=15000
# INGEST_WRITE_METADATA=true
# INGEST_ONCE=0

# Reolink: either full snapshot URL or host + credentials
# REOLINK_SNAPSHOT_URL=
# REOLINK_HOST=
# REOLINK_HTTP_PORT=80
# REOLINK_USER=
# REOLINK_PASSWORD=
# REOLINK_CHANNEL=0
# REOLINK_SNAPSHOT_PATH=/cgi-bin/api.cgi?cmd=Snap&channel={channel}&rs={timestamp}&user={usernameEncoded}&password={passwordEncoded}
# REOLINK_BURST_ENABLED=false
# REOLINK_BURST_COUNT=2
# REOLINK_BURST_INTERVAL_MS=350
# REOLINK_BURST_REQUIRE_SIGNAL=false

# UpCam (optional): full URL or host + basic auth
# UPCAM_SNAPSHOT_URL=
# UPCAM_HOST=
# UPCAM_USER=
# UPCAM_PASSWORD=

# --- Motion ---
# MOTION_RECEIVED_DIR=images/received
# MOTION_FILTERED_DIR=images/filtered
# MOTION_SENT_DIR=images/sent
# MOTION_POLL_MS=1000
# MOTION_ONCE=0
# MOTION_NOTIFY=true
# Conservative Reolink starting point after JPEG decode + ROI.
# MOTION_SCORE_THRESHOLD=0.08
# MOTION_IMAGE_DECODE_ENABLED=true
# MOTION_RESIZE_WIDTH=384
# MOTION_CROP_TOP_PX=24
# MOTION_ROI_POLYGONS_JSON=[[{"x":60,"y":42},{"x":122,"y":40},{"x":186,"y":170},{"x":96,"y":191},{"x":56,"y":191},{"x":60,"y":92}],[{"x":176,"y":126},{"x":300,"y":132},{"x":336,"y":191},{"x":212,"y":191}]]
# MOTION_PIXEL_DIFF_THRESHOLD=17
# MOTION_SAMPLE_STRIDE=16
# MOTION_ROI_START=0
# MOTION_ROI_END=1
# MOTION_ZONES_JSON=
# MOTION_BRIGHTNESS_MIN=8
# MOTION_BRIGHTNESS_MAX=248
# MOTION_CONFIRM_COUNT=3
# MOTION_COOLDOWN_MS=9000
# MOTION_MAX_SENDS=4
# MOTION_EVENT_IDLE_MS=30000









# Runtime cleanup
# CLEANUP_ENABLED=true
# CLEANUP_INTERVAL_MS=300000
# CLEANUP_IMAGES_ENABLED=true
# CLEANUP_IMAGES_MAX_AGE_HOURS=36
# CLEANUP_IMAGE_DIRS=images/received,images/filtered,images/sent
# CLEANUP_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.json
# CLEANUP_LOGS_ENABLED=true
# CLEANUP_LOGS_MAX_AGE_HOURS=48
# CLEANUP_LOG_DIRS=logs
# CLEANUP_LOG_EXTENSIONS=.log,.ndjson,.txt
